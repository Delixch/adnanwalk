# --- ADNAN WALK SECURITY ---
# Panel yükleme şifresi (Geliştirme aşamasında varsayılan: adnan123)
UPLOAD_PASSWORD=adnan123

# --- CLOUDINARY BULUT MEDYA YÖNETİMİ ---
# Cloudinary hesabınızdan alacağınız API anahtarları. 
# Bu alanlar doldurulduğunda sistem otomatik olarak yerel disk yerine Cloudinary'ye yükleme yapacaktır.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- SUPABASE BULUT VERİTABANI (İsteğe bağlı) ---
# Eğer verileri yerel database.json dosyası yerine bulutta saklamak isterseniz:
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key

# Servis anahtarı (service_role) — Supabase panelinde Settings > API altında.
# Tablodaki RLS politikaları anon anahtarına DELETE izni vermediği için silme
# işlemi bu anahtarla yapılır. SADECE sunucuda kullanılır, tarayıcıya gitmez.
# Boş bırakılırsa sistem anon anahtarına düşer ve silme sessizce başarısız olur.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
